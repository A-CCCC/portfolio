# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Full-res render frames kept locally as the source for public/*-anim
# (regenerate optimised frames from these; too large to commit)
source-frames

# Working folders kept locally: raw exports and originals that the optimised
# assets in public/ are generated from, plus the alternate frame set
source-photos
source-thumbnails
skeleton-barrel-anim-alt
*.psd

# Fusion/render exports
elixir collector build
skeleton barrel build

# Source 3D models, kept locally rather than shipped with the site
source-models

# Source recordings and the previous build video
source-videos

# Screen recordings the build videos are made from
cannon cart build
mortar build

# Blender's automatic backups: a stale copy of the .blend beside it
*.blend1

# Copy kept off the public site: page descriptions and contact details. The
# build falls back to an under-construction state when this is absent, which is
# what GitHub produces, since it never receives it.
src/data/private

# Test harnesses dropped into public/ to measure the site at phone sizes. They
# have to be served from the site's own origin to be able to read the page
# inside them, which means living here — but they are not part of it.
public/audit.html
public/shot*.html
public/probe*.html
public/menutest.html
public/canvastest.html
public/typetest.html
public/bubbletest.html
public/check.html
